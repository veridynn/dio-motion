---
import { copy, type Locale, routes, sectionIds } from "../lib/i18n";
import { commit, preview, version } from "../lib/version";
import Icon from "./Icon.astro";
import Link from "./Link.astro";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<footer class="footer">
	<div class="footer__cols">
		<div class="footer__brand">
			<a class="wordmark" href={routes.home[locale]}>dio motion.</a>
			<p class="footer__tagline">{t.tagline}</p>
		</div>
		<nav class="footer__navigation" aria-labelledby="footer-navigation-label">
			<p class="footer__label" id="footer-navigation-label">Navigation</p>
			<ul class="footer__list">
				<li>
					<Link href={`${routes.home[locale]}#${sectionIds.potential[locale]}`}
						>{t.potential}</Link
					>
				</li>
				<li>
					<Link href={`${routes.home[locale]}#${sectionIds.approach[locale]}`}
						>{t.approach}</Link
					>
				</li>
				<li>
					<Link href={`${routes.home[locale]}#${sectionIds.services[locale]}`}
						>{t.services}</Link
					>
				</li>
				<li>
					<Link href={`${routes.home[locale]}#${sectionIds.about[locale]}`}
						>{t.about}</Link
					>
				</li>
				<li>
					<Link href={routes.contact[locale]}>{t.contact}</Link>
				</li>
			</ul>
		</nav>
	</div>
	<div class="footer__bottom">
		<span class="footer__copyright"
			>© {new Date().getFullYear()} dio motion.</span
		>
		<Link class="footer__legal" href={routes.legal[locale]}>{t.legal}</Link>
		<Link class="footer__privacy" href={routes.privacy[locale]}
			>{t.privacy}</Link
		>
		<Link
			class="footer__credit"
			href="https://github.com/veridynn"
			aria-label="Website by veridynn"
			target="_blank"
			rel="noopener noreferrer"
		>
			{"Website by"}<Icon name="github" inline />{"veridynn"}
		</Link>
		<span
			class="footer__version"
			data-site-version={version}
			title={preview ? t.preview : undefined}
		>
			v{version}{commit && `+${commit.slice(0, 7)}`}
		</span>
	</div>
</footer>
<style>
	.footer {
		background: var(--smoke);
		color: var(--ivory);
		padding: var(--space-3xl) var(--gutter) var(--space-xl);
	}
	.footer__cols {
		max-width: var(--measure);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: var(--space-xl);
	}
	.footer__brand {
		flex: 1 1 12rem;
	}
	.footer__navigation {
		width: max-content;
	}
	.footer__brand .wordmark {
		color: var(--ivory);
		font-size: var(--fs-base);
		font-weight: 500;
		letter-spacing: 0.01em;
		text-decoration: none;
	}
	.footer__tagline {
		margin-top: var(--space-sm);
		font-weight: 300;
		font-style: italic;
		font-size: var(--fs-sm);
		color: var(--ivory);
		opacity: 0.65;
	}
	.footer__label {
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: var(--fs-sm);
		color: var(--ivory);
		opacity: 0.65;
	}
	.footer__list {
		list-style: none;
		margin: var(--space-xs) 0 0;
		padding: 0;
		font-size: var(--fs-sm);
		color: color-mix(in srgb, var(--ivory) 70%, var(--smoke));
	}
	.footer__list :global(a) {
		display: flex;
		align-items: center;
		min-height: 2rem;
		line-height: 1.5;
	}
	.footer__bottom {
		max-width: var(--measure);
		margin: var(--space-2xl) auto 0;
		padding-top: var(--space-lg);
		border-top: 1px solid var(--graphit);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		grid-template-areas:
			"copyright legal privacy"
			"credit version version";
		align-items: baseline;
		gap: var(--space-sm) var(--space-lg);
		font-size: var(--fs-sm);
		color: #aaa49b;
	}
	.footer__bottom > :global(a) {
		justify-self: start;
	}
	.footer__copyright {
		grid-area: copyright;
	}
	.footer__bottom > :global(.footer__legal) {
		grid-area: legal;
	}
	.footer__bottom > :global(.footer__privacy) {
		grid-area: privacy;
	}
	.footer__version {
		grid-area: version;
		justify-self: end;
	}
	.footer__bottom > :global(.footer__credit) {
		grid-area: credit;
		white-space: nowrap;
	}
	@media (max-width: 860px) {
		.footer {
			padding-top: var(--space-xl);
			padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
		}
		.footer__bottom {
			margin-top: var(--space-lg);
			padding-top: var(--space-lg);
		}
	}
	@media (max-width: 540px) {
		.footer__bottom {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: "copyright" "legal" "privacy" "credit" "version";
		}
		.footer__version {
			justify-self: start;
		}
	}
</style>
