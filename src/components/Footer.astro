---
import { copy, routes, sectionIds, type Locale } from '../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<footer class="footer">
  <div class="footer__cols">
    <div class="footer__brand">
      <a class="wordmark" href={routes.home[locale]}>dio motion.</a>
      <p class="footer__tagline">{t.tagline}</p>
    </div>
    <div class="footer__navigation">
      <p class="footer__label">Navigation</p>
      <ul class="footer__list">
        <li><a href={`${routes.home[locale]}#${sectionIds.potential[locale]}`}>{t.potential}</a></li>
        <li><a href={`${routes.home[locale]}#${sectionIds.approach[locale]}`}>{t.approach}</a></li>
        <li><a href={`${routes.home[locale]}#${sectionIds.services[locale]}`}>{t.services}</a></li>
        <li><a href={`${routes.home[locale]}#${sectionIds.about[locale]}`}>{t.about}</a></li>
        <li><a href={routes.contact[locale]}>{t.contact}</a></li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <span>© {new Date().getFullYear()} dio motion.</span>
    <span class="footer__legal">
      <span>{t.legal}</span>
      <span>{t.privacy}</span>
    </span>
  </div>
</footer>
<style>
.footer{
  background:var(--smoke); color:var(--ivory);
  padding:var(--space-3xl) var(--gutter) var(--space-xl);
}
.footer__cols{
  max-width:var(--measure); margin:0 auto;
  display:flex; flex-wrap:wrap; align-items:flex-start;
  gap:var(--space-xl);
}
.footer__brand{ flex:1 1 12rem; }
.footer__navigation{ width:max-content; }
.footer__brand .wordmark{ color:var(--ivory); font-size:var(--fs-base); font-weight:500; letter-spacing:.01em; text-decoration:none; }
.footer__tagline{
  margin-top:var(--space-sm); font-weight:300; font-style:italic;
  font-size:var(--fs-sm); color:var(--ivory); opacity:.65;
}
.footer__label{
  font-weight:600; text-transform:uppercase; letter-spacing:.2em;
  font-size:var(--fs-sm); color:var(--ivory); opacity:.65;
}
.footer__list{ list-style:none; margin:var(--space-xs) 0 0; padding:0; }
.footer__list a{
  display:flex; align-items:center; min-height:2rem;
  line-height:1.5;
  font-size:var(--fs-sm); color:var(--ivory); opacity:.7;
  text-decoration:none; transition:color .3s ease, opacity .3s ease;
}
.footer__list a:hover{ color:var(--sandstein); opacity:1; }
.footer__bottom{
  max-width:var(--measure); margin:var(--space-2xl) auto 0;
  padding-top:var(--space-lg); border-top:1px solid var(--graphit);
  display:flex; justify-content:space-between; gap:var(--space-lg); flex-wrap:wrap;
}
.footer__bottom, .footer__bottom a{
  font-size:var(--fs-sm); color:var(--ivory); opacity:.4; text-decoration:none;
}
.footer__bottom a:hover{ opacity:.8; }
.footer__legal{ display:flex; gap:var(--space-lg); }
.footer__bottom { opacity: 1; color: #aaa49b; }
.footer__legal { flex-wrap: wrap; }
@media (max-width: 860px) {
  .footer { padding-bottom:calc(var(--space-xl) + 4rem + env(safe-area-inset-bottom)); }
}

</style>
