---
import { copy, type Locale, sectionIds } from "../../lib/i18n";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section
	class="section section--light bridge"
	id={sectionIds.potential[locale]}
>
	<div class="bridge__inner center">
		<h2 class="h-section reveal">{t.bridge}</h2>
		<p class="lead reveal">{t.bridgeLead}</p>
	</div>
</section>
<style>
	.bridge__inner {
		max-width: 44rem;
		margin: 0 auto;
	}
	.bridge .lead {
		margin-top: var(--space-lg);
	}
</style>
