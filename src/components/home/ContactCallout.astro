---
import ContactForm from '../ContactForm.svelte';
import { copy, type Locale } from '../../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<section class="section section--light contact" id="kontakt" aria-labelledby="contact-heading">
  <div class="wrap">
    <h2 class="h-section" id="contact-heading">{t.ready}</h2>
    <p class="lead">{t.contactLead}</p>
    <ContactForm accessKey={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} locale={locale} client:load transition:persist="contact-form" />
  </div>
</section>
<style>
.contact .wrap{ max-width:34rem; }
.contact .lead{ margin-top:1.5rem; }
</style>
