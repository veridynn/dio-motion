---
import { copy, routes, type Locale } from '../../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<section class="section section--light" id="ansatz">
  <div class="wrap">
    <h2 class="h-section center reveal">{t.approachHeading[0]}<em>{t.approachHeading[1]}</em>{t.approachHeading[2]}<em>{t.approachHeading[3]}</em>{t.approachHeading[4]}</h2>
    <div class="pillars">
      {t.pillars.map(([title, body]) => (
        <div class="pillar reveal"><h3>{title}</h3><p class="body">{body}</p></div>
      ))}
    </div>
  </div>
</section>
<style>
.pillars{
  display:grid; grid-template-columns:repeat(3,1fr);
  gap:clamp(2rem,5vw,4.5rem);
  margin-top:clamp(4rem,9vh,7rem);
}
.pillar h3{ font-weight:400; font-size:1.25rem; letter-spacing:-.005em; }
.pillar p{ margin-top:1.125rem; }
@media (max-width: 860px) { .pillars { grid-template-columns: 1fr; gap: 3rem; } }
</style>
