---
import { copy, type Locale, sectionIds } from "../../lib/i18n";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section class="section section--light" id={sectionIds.approach[locale]}>
	<div class="wrap">
		<h2 class="h-section center reveal">
			{t.approachHeading[0]}<em>{t.approachHeading[1]}</em>
			{t.approachHeading[2]}<em>{t.approachHeading[3]}</em>
			{t.approachHeading[4]}
		</h2>
		<div class="pillars">
			{t.pillars.map(([title, body]) => (
				<div class="pillar reveal">
					<h3>{title}</h3>
					<p class="body">{body}</p>
				</div>
			))}
		</div>
	</div>
</section>
<style>
	.pillars {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-xl);
		margin-top: var(--space-2xl);
	}
	.pillar h3 {
		font-weight: 400;
		font-size: var(--fs-md);
		letter-spacing: -0.005em;
	}
	.pillar p {
		margin-top: var(--space-md);
	}
	@media (min-width: 861px) {
		.pillars {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
