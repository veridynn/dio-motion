---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ContactForm from '../ContactForm.astro';
import { copy, type Locale } from '../../lib/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
---
<SiteLayout title={t.contactTitle} description={t.contactDescription} locale={locale} page="contact" contact>
  <div class="contact-page">

  <div class="wrap">
    <h1>{t.cta}.</h1>
    <p class="lead">{t.contactLead}</p>

    <ContactForm locale={locale} />

    <p class="alt">
      {t.contactAlternative}<br>
      <a href={`mailto:silvo@diomotion.com?subject=${encodeURIComponent(t.emailSubject)}`}>silvo@diomotion.com</a>
    </p>

    
  </div>

  </div>
</SiteLayout>
<style>
.contact-page{
  flex:1;
  padding:clamp(4rem,12vh,8rem) var(--gutter);
}
.wrap{ max-width:34rem; margin:0 auto; }

h1{
  font-weight:200; font-size:clamp(1.875rem,4.4vw,3rem);
  line-height:1.15; letter-spacing:-.015em;
}
.lead{
  margin-top:1.5rem; font-size:1rem; line-height:1.65; color:var(--asche);
}

.alt{
  margin-top:clamp(3.5rem,8vh,5rem);
  padding-top:2rem; border-top:1px solid var(--leinen);
  font-size:.875rem; line-height:1.7; color:var(--asche);
}
.alt a{ color:var(--asche); text-decoration:none; border-bottom:1px solid var(--leinen); }
.alt a:hover{ color:var(--sandstein); }


</style>
