---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	href: string;
}
const { href, ...attributes } = Astro.props;
---

<!-- biome-ignore lint/a11y/useAnchorContent: Callers supply accessible link text through the slot. -->
<a href={href} {...attributes}><slot /></a>

<style>
	a {
		color: inherit;
		text-decoration: none;
		transition: color 0.3s ease;
	}
	a:hover,
	a:focus-visible {
		color: var(--ivory);
		text-decoration: underline;
	}
</style>
